/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "img-api-worker",
	"main": "src/index.js",
	// ctx.exports (the gateway's loopback to `Transform`) is on from 2025-11-17.
	"compatibility_date": "2026-07-06",
	"observability": {
		"enabled": true,
	},
	// Workers Cache in front of `Transform` only: the gateway runs on every
	// request and computes the key (src/index.js `transformCacheKey`). The cache
	// outlives deploys because a key's bytes never change; a change to the
	// transform itself bumps CACHE_KEY_VERSION in src/index.js.
	"cache": {
		"enabled": true,
		"cross_version_cache": true,
	},
	"exports": {
		"default": { "type": "worker", "cache": { "enabled": false } },
		"Transform": { "type": "worker", "cache": { "enabled": true } },
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "media",
		},
		{
			// Keys whose first segment ends in -staging, -preview or -sandbox (src/index.js isStagingKey).
			"binding": "MEDIA_STAGING_BUCKET",
			"bucket_name": "media-staging",
		},
	],
	"routes": [
		{
			"pattern": "img.arroweffect.com/*",
			"zone_name": "arroweffect.com",
		},
		{
			"pattern": "img.afxengine.com/*",
			"zone_name": "afxengine.com",
		},
	],
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },

	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */

	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// The custom domains of `media` and `media-staging`.
	"vars": {
		"CDN_ORIGIN": "https://cdn.afxengine.com",
		"CDN_STAGING_ORIGIN": "https://cdn-staging.afxengine.com",
		"ARROWEFFECT_ORIGIN": "https://media.arroweffect.com",
	},
	// "vars": { "MY_VARIABLE": "production_value" },
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */

	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },

	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
